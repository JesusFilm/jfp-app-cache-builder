{
  "name": "tool",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tool/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsc --project tsconfig.app.json && cp -r src/__generated__ dist/",
        "cwd": "apps/tool"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/main.ts",
        "cwd": "apps/tool"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run",
        "cwd": "apps/tool"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputFile}"],
      "options": {
        "command": "eslint src/**/*.ts",
        "cwd": "apps/tool"
      }
    },
    "export-dbs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ./tsconfig.json scripts/export-dbs.ts",
        "cwd": "apps/tool"
      }
    }
  },
  "tags": []
}
