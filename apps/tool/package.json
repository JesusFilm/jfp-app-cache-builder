{
  "name": "tool",
  "version": "1.0.0",
  "description": "Command line tool to build and populate databases from Jesus Film Project API for iOS and Android applications",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "jfp-app-cache-builder": "./bin/jfp-app-cache-builder"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "tsc --project tsconfig.app.json && cp -r src/__generated__ dist/",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "cli": "pnpm run build && ./bin/jfp-app-cache-builder",
    "export:dbs": "tsx --tsconfig ./tsconfig.json scripts/export-dbs.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@prisma/adapter-better-sqlite3": "^6.13.0",
    "@prisma/client": "^6.13.0",
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.0",
    "graphql": "^16.11.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "plist": "^3.1.0",
    "realm": "^12.14.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/plist": "^3.0.5",
    "gql.tada": "^1.8.12",
    "prisma": "^6.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^3.1.0"
  },
  "graphql": {
    "schema": "https://api-gateway.central.jesusfilm.org",
    "documents": "src/**/*.{graphql,js,ts,jsx,tsx}"
  }
}
