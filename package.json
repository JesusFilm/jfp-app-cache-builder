{
  "name": "jfp-app-cache-builder",
  "version": "1.0.0",
  "description": "Command line tool to build and populate databases from Jesus Film Project API for iOS and Android applications",
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "scripts": {
    "build": "nx run-many -t build",
    "build:tool": "nx run tool:build",
    "build:website": "nx run website:build",
    "dev": "nx run tool:serve",
    "dev:tool": "nx run tool:serve",
    "dev:website": "nx run website:serve",
    "start": "nx run tool:serve",
    "start:website": "nx run website:serve",
    "test": "nx run-many -t test",
    "test:tool": "nx run tool:test",
    "test:website": "nx run website:test",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cli": "nx run tool:build && ./apps/tool/bin/jfp-app-cache-builder",
    "export:dbs": "nx run tool:export-dbs",
    "type-check": "nx run-many -t type-check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nx/eslint": "^21.6.5",
    "@nx/jest": "^21.6.5",
    "@nx/next": "^21.6.5",
    "@nx/node": "^21.6.5",
    "@nx/vite": "^21.6.5",
    "@nx/workspace": "^21.6.5",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "nx": "^21.6.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "realm": "npm:realm@community"
    }
  }
}
